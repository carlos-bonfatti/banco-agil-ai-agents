# Não incluir chaves reais neste arquivo.
# O ambiente padrão usa interpretação local determinística (sem LLM).
BANCO_DATA_DIR=runtime/data
BANCO_LLM_MODE=demo
# Para interpretação por Gemini: definir mode=gemini e a chave no ambiente.
GEMINI_API_KEY=
# Escolher um modelo disponível na sua conta; nenhum nome é presumido.
GEMINI_MODEL=
# Cotação: demo (simulada) ou live (AwesomeAPI).
BANCO_FX_MODE=demo
BANCO_GRAPH=local
# Limites locais: o Engine é compartilhado na UI; não há coordenação entre réplicas.
BANCO_MAX_LLM_CALLS_PER_SESSION=20
BANCO_MAX_LLM_CALLS_PER_ENGINE=200
BANCO_SESSION_IDLE_SECONDS=900
